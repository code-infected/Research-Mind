# === ResearchMind ===
# Copy to .env and fill in your API keys.
# Not all keys are required — just fill in whichever providers you have.

# --- LLM Provider ---
# Primary model
# Options: groq | gemini | openrouter | anthropic
LLM_PROVIDER=groq

# Optional — overrides LLM_PROVIDER if set
# Paste model name directly from provider docs
# Provider prefix added automatically if missing
# Examples:
#   qwen/qwen3-32b
#   llama-3.3-70b-versatile
#   groq/llama-3.3-70b-versatile
#   claude-sonnet-4-20250514
LLM_MODEL=

# Fallback chain — comma separated, tried in order if primary fails
# Leave empty to disable fallbacks
# Must use full LiteLLM model strings with provider prefix
# Example: groq/llama-3.3-70b-versatile,gemini/gemini-2.0-flash
LLM_FALLBACK_MODELS=

# --- API Keys (fill in the ones you have) ---
# Anthropic Claude — save credits for demos
ANTHROPIC_API_KEY=sk-ant-...

# Groq — fast, generous free tier (recommended for dev)
GROQ_API_KEY=gsk_...

# OpenRouter — variety of free models
OPENROUTER_API_KEY=sk-or-...

# Google AI Studio / Gemini — free tier
GOOGLE_API_KEY=...

# --- Web Search ---
# Tavily Search API (Optimized for Agents)
# https://tavily.com (Optional — defaults to free DuckDuckGo if missing)
TAVILY_API_KEY=tvly-your_key_here

# --- Database ---
# Supabase PostgreSQL connection string
# https://supabase.com → Project → Settings → Database → Connection string
DATABASE_URL=
# --- Auth (Clerk) ---
# https://dashboard.clerk.com → API Keys
CLERK_FRONTEND_API=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Optional ---
# ChromaDB storage path
# CHROMA_DB_PATH=./chroma_data
# MAX_SUB_QUESTIONS=5

# Maximum tool calls allowed per sub-question (prevents infinite loops)
MAX_TOOL_CALLS_PER_QUESTION=5

# Maximum unique sources to read per sub-question
MAX_SOURCES_PER_QUESTION=3
# INCLUDE_ARXIV=true

# --- Frontend ---
# Backend API URL for Next.js to access FastAPI
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
